FROM golang:1.24-alpine AS build

WORKDIR /src
COPY go.mod ./
COPY apps ./apps
COPY packages ./packages
RUN go build -o /out/nexis-console ./apps/console

FROM alpine:3.20

WORKDIR /opt/nexis
COPY --from=build /out/nexis-console /usr/local/bin/nexis-console
COPY apps/web ./apps/web
COPY deploy/config/console.yaml ./deploy/config/console.yaml

EXPOSE 47131 47141 47151 47191 47300-47999
CMD ["nexis-console", "-config", "deploy/config/console.yaml"]

